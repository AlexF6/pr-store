<div class="container mx-auto py-10 max-w-6xl">
  <h1 class="text-3xl md:text-4xl font-bold mb-8 text-transparent bg-clip-text bg-linear-to-r from-gray-100 to-gray-400">
    Your Cart
  </h1>

  <% if @cart.cart_items.any? %>
    <div class="flex flex-col lg:flex-row gap-8 relative">
      
      <!-- LEFT SECTION: PRODUCT LIST -->
      <div class="w-full lg:w-3/4 space-y-4">
        
        <!-- Headers (Only visible on Desktop) -->
        <div class="hidden md:grid grid-cols-12 text-sm font-semibold text-gray-400 uppercase tracking-wider px-4 pb-2 border-b border-gray-800">
          <div class="col-span-6">Product</div>
          <div class="col-span-2 text-center">Price</div>
          <div class="col-span-2 text-center">Quantity</div>
          <div class="col-span-2 text-right">Total</div>
        </div>

        <!-- List of Items -->
        <div class="space-y-4">
          <% @cart.cart_items.each do |item| %>
            <div class="group relative flex flex-col md:grid md:grid-cols-12 items-center p-4 rounded-2xl bg-gray-900/60 backdrop-blur-sm border border-white/5 hover:border-purple-500/30 transition-all duration-300 shadow-lg">
              
              <!-- 1. Product Info -->
              <div class="flex items-center w-full md:col-span-6 gap-4 mb-4 md:mb-0">
                <div class="relative shrink-0">
                  <%= image_tag item.product.image_src,
                      alt: item.product.name,
                      class: "w-20 h-20 md:w-16 md:h-16 object-cover rounded-xl shadow-md border border-gray-700" %>
                </div>
                <div class="flex flex-col">
                  <span class="text-base font-semibold text-gray-100 group-hover:text-purple-300 transition-colors">
                    <%= item.product.name %>
                  </span>
                  <span class="text-xs text-gray-500">Ref: <%= item.product.id %></span>
                  
                  <!-- Delete button (visible on mobile devices below the name) -->
                  <div class="md:hidden mt-2">
                     <%= button_to cart_item_path(item), method: :delete, 
                          data: { turbo_confirm: "¿Eliminar este producto?" },
                          class: "text-xs text-red-400 hover:text-red-300 flex items-center gap-1" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                        Eliminar
                     <% end %>
                  </div>
                </div>
              </div>

              <!-- 2. Unit Price -->
              <div class="flex justify-between w-full md:w-auto md:col-span-2 md:justify-center mb-2 md:mb-0">
                <span class="md:hidden text-gray-500 text-sm">Precio:</span>
                <span class="text-gray-300 text-sm"><%= number_to_currency(item.unit_price) %></span>
              </div>

              <!-- 3. Quantity -->
              <div class="flex justify-between w-full md:w-auto md:col-span-2 md:justify-center mb-2 md:mb-0">
                <span class="md:hidden text-gray-500 text-sm">Quantity:</span>
                
                <%= form_with model: item, url: cart_item_path(item), method: :put, local: true, data: { turbo: false }, class: "flex items-center" do |f| %>
                  

                  <div class="flex items-center h-10 rounded-xl border border-gray-700 bg-gray-800/50 hover:border-purple-500/50 transition-colors shadow-inner overflow-hidden">
                    
                    <button type="button" 
                            onclick="var input = this.nextElementSibling; input.stepDown(); input.form.requestSubmit();"
                            class="w-8 h-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition active:scale-95 disabled:opacity-50"
                            <%= 'disabled' if item.quantity <= 1 %>>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
                      </svg>
                    </button>

                    <%= f.number_field :quantity, value: item.quantity, min: 1, max: 99,
                          class: "w-10 bg-transparent border-none text-center text-sm font-semibold text-gray-100 p-0 focus:ring-0 appearance-none [-moz-appearance:_textfield] [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none",
                          onchange: "this.form.requestSubmit();" %>

                    <button type="button" 
                            onclick="var input = this.previousElementSibling; input.stepUp(); input.form.requestSubmit();"
                            class="w-8 h-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition active:scale-95">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                      </svg>
                    </button>
                    
                  </div>
                <% end %>
              </div>

              <!-- 4. Subtotal -->
              <div class="flex justify-between w-full md:w-auto md:col-span-2 md:justify-end items-center">
                <span class="md:hidden text-gray-500 text-sm">Subtotal:</span>
                <span class="text-purple-300 font-bold"><%= number_to_currency(item.subtotal) %></span>
                
                <div class="hidden md:block ml-4">
                  <%= button_to cart_item_path(item), method: :delete, 
                        class: "p-2 text-gray-500 hover:text-red-500 transition-colors rounded-full hover:bg-red-500/10",
                        title: "Eliminar producto" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                </div>
              </div>

            </div>
          <% end %>
        </div>
      </div>

      <div class="w-full lg:w-1/4 mt-8 lg:mt-0">
        <div class="sticky top-6 rounded-2xl bg-gray-900/80 backdrop-blur-md border border-white/10 p-6 shadow-xl">
          <h2 class="text-xl font-bold text-gray-100 mb-6">Summary</h2>
          
          <div class="space-y-3 mb-6 text-sm">
            <div class="flex justify-between text-gray-400">
              <span>Subtotal</span>
              <span><%= number_to_currency(@cart.total) %></span>
            </div>
            <div class="flex justify-between text-gray-400">
              <span>Shipping</span>
              <span class="text-green-400">Free</span>
            </div>
            <div class="border-t border-gray-700 my-2"></div>
            
            <div class="flex justify-between items-end">
              <span class="text-lg font-bold text-gray-100">Total</span>
              <span class="text-2xl font-bold text-transparent bg-clip-text bg-linear-to-r from-purple-400 to-pink-400">
                <%= number_to_currency(@cart.total) %>
              </span>
            </div>
          </div>

          <%= link_to "#", onclick: "document.getElementById('flash-message').classList.remove('hidden'); return false;", 
                class: "w-full block text-center py-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold shadow-lg shadow-purple-900/50 transform hover:-translate-y-0.5 transition-all duration-200" do %>
            Proceed to Payment
          <% end %>
          
          <p class="text-xs text-gray-500 text-center mt-4">
            Secure encrypted payment
          </p>

           <div id="flash-message" class="hidden mt-4 p-3 text-sm text-amber-200 bg-amber-900/30 border border-amber-700/50 rounded-lg text-center animate-pulse">
             Checkout not available at this time.
           </div>
        </div>
      </div>

    </div>

  <% else %>
    <div class="flex flex-col items-center justify-center py-24 text-center bg-gray-900/30 rounded-3xl border border-white/5 backdrop-blur-sm">
      <div class="bg-gray-800/50 p-6 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-200 mb-2">Your cart is empty</h2>
      <p class="text-gray-400 mb-8 max-w-md">It seems you haven't added anything yet. Explore our collection and find something unique..</p>
      <%= link_to products_path, 
            class: "px-8 py-3 rounded-xl bg-gray-100 text-gray-900 hover:bg-white font-semibold shadow-lg shadow-white/10 transition-all" do %>
        Explore Products
      <% end %>
    </div>
  <% end %>
</div>