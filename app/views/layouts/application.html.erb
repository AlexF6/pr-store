<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Elysium" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= asset_path "icon3.svg" %>">
    <link rel="icon" href="/icon2.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      @keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }
      .animate-slide-in {
        animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }
    </style>
  </head>

  <body>
    <div id="flash-container" class="fixed top-24 right-5 z-50 flex flex-col gap-3 w-full max-w-sm pointer-events-none">
      <% flash.each do |type, message| %>
        <% 
           if type == "alert"
             bg_class = "bg-red-900/90 border-red-500/50 text-white"
             icon = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
           else
             bg_class = "bg-purple-900/90 border-purple-500/50 text-white"
             icon = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
           end
        %>
        
        <div class="pointer-events-auto flex items-start p-4 rounded-xl border shadow-xl backdrop-blur-md animate-slide-in <%= bg_class %>" role="alert">
          <!-- Icon -->
          <div class="flex-shrink-0 mt-0.5">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon %>" />
            </svg>
          </div>
          
          <div class="ml-3 flex-1">
            <p class="text-sm font-medium"><%= message %></p>
          </div>

          <button onclick="this.parentElement.remove()" class="ml-4 flex-shrink-0 text-white/60 hover:text-white transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>

    <script>
      document.addEventListener("turbo:load", function() {
        const flashes = document.querySelectorAll('#flash-container > div');
        if (flashes.length > 0) {
          setTimeout(() => {
            flashes.forEach(flash => {
              flash.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
              flash.style.opacity = '0';
              flash.style.transform = 'translateX(20px)';
              setTimeout(() => flash.remove(), 500);
            });
          }, 4000);
        }
      });
    </script>

    <div class="flex flex-col min-h-screen bg-black text-gray-300">
      <%= render "shared/navbar" %>

      <main class="flex grow relative">
        <div class="w-full inset-0 bg-linear-to-br z-10 from-purple-900/15 via-black to-purple-900/15">
          <div class="container mx-auto px-4">
            <%= yield %>
          </div>
        </div>
      </main>
      <div>
        <%= render "shared/footer" %>
      </div>
    </div>
  </body>
</html>